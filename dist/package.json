{
  "name": "goal-dashboard",
  "version": "0.18.0",
  "description": "Goal-Dashboard — a goal kanban board for DeepSeek Harness (DSH), with mattpocock/skills workflow integration.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "goals",
    "kanban",
    "goal-dashboard",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Silencehuliang/Goal-Dashboard.git"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.5-rc.2 <0.2.1-0 || >=0.2.0-rc.1 <0.2.1-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.2 <0.2.1-0 || >=0.2.0-rc.1 <0.2.1-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
